    "designPoints":  [
                         {
                             "type":  "tutorial-message",
                             "text":  "Welcome to my game. Thank you for trying it out! \u003c3",
                             "startTime":  21,
                             "endTime":  5518
                         },
                         {
                             "type":  "tutorial-message",
                             "text":  "Press Circle to hit the notes when they reach the ring\u0027s edge.",
                             "startTime":  7348,
                             "endTime":  13301
                         },
                         {
                             "type":  "tutorial-message",
                             "text":  "Press D-pad Left to hit the notes on the left side.",
                             "startTime":  22008,
                             "endTime":  27960
                         },
                         {
                             "type":  "tutorial-message",
                             "text":  "Some notes are Hold notes.\\n\\nKeep the button pressed until the hold note\u0027s tail reaches the edge.",
                             "startTime":  36664,
                             "endTime":  42160
                         },
                         {
                             "type":  "tutorial-message",
                             "text":  "Some notes move up or down. Use Up/Down or Triangle/X to hit them.",
                             "startTime":  51318.70992366412,
                             "endTime":  56817
                         },
                         {
                             "type":  "tutorial-message",
                             "text":  "Push the analog sticks to the edge and move them around.",
                             "startTime":  65973,
                             "endTime":  69177
                         },
                         {
                             "type":  "tutorial-message",
                             "text":  "Those colored arcs are your Catchers. Use them to catch colored dots.\\n\\nRemember: Red is on the Right",
