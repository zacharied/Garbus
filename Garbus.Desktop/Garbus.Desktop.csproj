<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Garbus</AssemblyName>
    <ApplicationIcon>game.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
  </PropertyGroup>
  <!-- Release publish: fold every managed DLL AND native lib (BASS/SDL/etc.) into
       Garbus.exe so the output folder is just the executable. The natives self-extract
       to %TEMP%\.net\Garbus\<hash> on first launch; osu-framework's loader resolves them
       there fine. Only active for Release so Debug builds and tests are unaffected. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Keep XML doc files (kept on for dev IntelliSense) out of the publish folder,
         including those from referenced projects. -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>
  <!-- The stbi native package ships a link-time import stub (.lib) that has no runtime
       use and isn't a native DLL, so it lands loose in the publish folder. Drop it. -->
  <Target Name="RemoveStrayImportLibs" AfterTargets="Publish">
    <ItemGroup>
      <_StrayImportLibs Include="$(PublishDir)*.lib" />
    </ItemGroup>
    <Delete Files="@(_StrayImportLibs)" />
  </Target>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\Garbus.Game\Garbus.Game.csproj" />
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Include="game.ico" />
  </ItemGroup>
  <ItemGroup Label="Updater scripts">
    <!-- Ship the matching updater beside the executable in the publish output.
         RID-conditioned so win-x64 gets only update.bat and linux-x64 only update.sh.
         Content stays loose (not bundled into the single-file exe); Link flattens it
         to the output root. -->
    <Content Include="Packaging\update.bat" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
      <Link>update.bat</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Packaging\update.sh" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
      <Link>update.sh</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
