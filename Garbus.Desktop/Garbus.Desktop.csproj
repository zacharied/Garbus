<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Garbus</AssemblyName>
    <ApplicationIcon>game.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
  </PropertyGroup>
  <!-- Release publish: fold every managed DLL into Garbus.exe so the output folder
       isn't buried under dependency assemblies. Native libs (BASS/SDL/etc.) are left
       beside the exe rather than self-extracted to %TEMP%, keeping osu-framework's own
       native loader happy. Only active for Release so Debug builds and tests are unaffected. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Keep XML doc files (kept on for dev IntelliSense) out of the publish folder,
         including those from referenced projects. -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\Garbus.Game\Garbus.Game.csproj" />
  </ItemGroup>
  <ItemGroup Label="Resources">
    <EmbeddedResource Include="game.ico" />
  </ItemGroup>
</Project>
